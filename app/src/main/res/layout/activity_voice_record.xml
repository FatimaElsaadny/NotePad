<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- ✅ Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarVoice"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorPrimary"
        app:title="Record Voice Note"
        app:titleCentered="true"
        app:titleTextColor="@color/cardTitleText"
        app:navigationIcon="@drawable/ic_arrow_back" />

    <!-- ✅ Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:layout_marginTop="?attr/actionBarSize">

        <!-- ✅ RECORD BUTTON (BIGGER, CENTERED, NO BACKGROUND) -->
        <ImageButton
            android:id="@+id/btnRecord"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:background="@null"
            android:scaleType="centerInside"
            android:src="@drawable/ic_microphone"
            app:tint="@color/fabColor"
            android:contentDescription="Record" />

        <!-- ✅ TIMER -->
        <TextView
            android:id="@+id/recordTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:textColor="@color/cardTitleText"/>

        <!-- ✅ STOP BUTTON (BIGGER, CENTERED, NO BACKGROUND) -->
        <ImageButton
            android:id="@+id/btnStop"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:background="@null"
            android:scaleType="centerInside"
            android:src="@drawable/ic_stop_button"
            app:tint="@color/fabColor"
            android:contentDescription="Stop"
            android:visibility="gone"
            android:layout_marginTop="30dp"/>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
